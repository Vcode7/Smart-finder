[Unit]
Description=Smart Finder backend (search and indexing, 127.0.0.1)
After=network-online.target
Wants=network-online.target
PartOf=smartfinder.target
ConditionPathExists=/opt/smartfinder/state/setup-complete

[Service]
Type=simple
# User= and Group= come from smartfinder-backend.service.d/user.conf (smartfinder-ctl set-user)
ExecStart=/usr/bin/smartfinder-ctl _run-backend
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillMode=mixed
LimitNOFILE=65536

[Install]
WantedBy=smartfinder.target
