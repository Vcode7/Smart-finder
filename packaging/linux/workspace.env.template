# Smart Finder web app settings (Linux package). Linked from /opt/smartfinder/app/workspace/.env.
# Both values are managed by smartfinder-ctl (setup / set-port backend).

# Must equal JWT_SECRET in backend.env
JWT_SECRET=
# Where the web app forwards /api/* (built into the app: changing it needs a rebuild,
# which smartfinder-ctl set-port backend does)
BACKEND_URL=http://127.0.0.1:8000
# Path the web app is served under, e.g. /smartfinder behind a reverse proxy (empty = root).
# Built into the app: after changing it run sudo smartfinder-ctl setup (rebuilds). Set
# PUBLIC_BASE_PATH in backend.env to the same value.
NEXT_BASE_PATH=
