# Smart Finder backend settings (Linux package). Linked from /opt/smartfinder/app/backend/.env.
# After editing: sudo smartfinder-ctl restart backend

# The backend listens on loopback only; the web app (FRONTEND_PORT in smartfinder.conf)
# is the network-facing entry point and proxies /api/* to it.
# Change the port with: sudo smartfinder-ctl set-port backend <port>
HOST=127.0.0.1
PORT=8000
# "local": no auto-reload, and the sign-in cookie works over plain HTTP from other devices
# ("production" marks it Secure, which needs HTTPS)
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage
DB_PATH=/var/lib/smartfinder/data/smartfind.db
UPLOAD_DIR=/var/lib/smartfinder/data/uploads
KB_DIR=/var/lib/smartfinder/data/knowledge_base
UPLOADS_LIBRARY_DIR=/var/lib/smartfinder/data/uploads-library
LIBRARY_FALLBACK_DIR=/var/lib/smartfinder/data/libraries

# AI models (about 14 GB). Download again with: sudo smartfinder-ctl models
HF_HOME=/var/lib/smartfinder/models
# Speech model: large-v3 (best, default), or medium / small on slow machines
# WHISPER_MODEL=large-v3
# Qwen3-VL-Reranker re-judges the best picture matches (~4 GB more VRAM):
# auto (default: on for GPUs with 12 GB or more) / on / off
# VISUAL_RERANK=auto

# OCR: PaddleOCR PP-OCRv6 (paddle, default) or Tesseract (tesseract)
# OCR_ENGINE=paddle
# OCR_PADDLE_MODEL=medium
# Tesseract language data from the tesseract-ocr-eng / tesseract-ocr-hin packages
TESSDATA_DIR=@TESSDATA_DIR@
OCR_LANGUAGES=eng+hin

# Authentication. smartfinder-ctl setup generates JWT_SECRET (copied to workspace.env)
# and a random admin password, shown once.
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@smartfind.ai
ADMIN_PASSWORD=choose-a-strong-password
ALLOW_SIGNUP=false

# Groq AI (chat answers)
GROQ_API_KEY=
GROQ_API_KEY_FALLBACK1=
GROQ_API_KEY_FALLBACK2=
GROQ_API_KEY_FALLBACK3=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FAST_MODEL=qwen/qwen3.8-27b

# External search keys (optional; built-in fallbacks are used when empty)
YOUTUBE_API_KEY=
SERP_API_KEY=
NEWS_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
