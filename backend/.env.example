# Server settings
# The backend listens on loopback only. The Next.js frontend (port 3000) is the
# network-facing entry point and proxies /api/* to this server.
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Storage & Database paths (resolved relative to backend/ by default)
DB_PATH=data/smartfind.db
# Legacy stores from before folder libraries (kept until scripts/migrate_legacy.py --finalize)
UPLOAD_DIR=data/uploads
KB_DIR=data/knowledge_base

# Folder libraries. Each library keeps its index in a hidden .smartfind folder inside the
# folder itself; files are indexed where they are and never copied.
# Browser uploads go to the built-in Uploads library (must differ from UPLOAD_DIR):
UPLOADS_LIBRARY_DIR=data/uploads-library
# Index location for read-only folders and for individually linked files:
LIBRARY_FALLBACK_DIR=data/libraries

# OCR: PaddleOCR PP-OCRv6 (paddle, default) or Tesseract (tesseract). PP-OCRv6 reads
# English and Latin-script text; Hindi lines it is unsure of are re-read by Tesseract.
# OCR_ENGINE=paddle
# Model size: tiny / small / medium (default: medium with a GPU, small without)
# OCR_PADDLE_MODEL=medium
# OCR_PADDLE_MIN_CONFIDENCE=0.80
# OCR languages (Tesseract traineddata in backend/tessdata)
TESSDATA_DIR=tessdata
OCR_LANGUAGES=eng+hin
# AI model cache (about 14 GB; default C:/Users/<you>/.cache/huggingface). Download with
# scripts/prefetch_models.py — setup.bat does this.
# HF_HOME=D:/hf-cache
# Speech model: large-v3 (best, default), or medium / small on slow machines
# WHISPER_MODEL=large-v3
# Qwen3-VL-Reranker re-judges the best picture matches (~4 GB more VRAM):
# auto (default: on for GPUs with 12 GB or more) / on / off
# VISUAL_RERANK=auto

# Authentication — setup.bat generates a random JWT_SECRET; it must match workspace/.env
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@smartfind.ai
ADMIN_PASSWORD=choose-a-strong-password
# Allow anyone who can reach the frontend to create an account (off by default)
ALLOW_SIGNUP=false
# Code that lets someone create an administrator account from the sign-in page.
# setup.bat generates one on a fresh install; leave as-is (or empty) to disable it.
ADMIN_SETUP_CODE=choose-a-setup-code
# Demo administrator, created at startup if missing (clear DEMO_ADMIN_EMAIL to turn it off)
DEMO_ADMIN_EMAIL=a@g.com
DEMO_ADMIN_PASSWORD=123456

# Ollama (local model, tried first). The model can also be picked in Settings.
# OLLAMA_ENDPOINT=http://localhost:11434
# OLLAMA_MODEL=qwen3.5:9b
# Seconds to wait for a reply (the first request also loads the model)
# OLLAMA_TIMEOUT=120

# Groq AI (used when Ollama is unreachable or fails). Get a key at console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FAST_MODEL=qwen/qwen3.8-27b

# External Search Keys (Optional - built-in fallbacks provided)
YOUTUBE_API_KEY=
SERP_API_KEY=
NEWS_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
